  levelId: 2-1
  groupName: "\u0426\u0435\u043B\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u0442\u0438\u043F\u044B"
  groupName_en: Integer types
  levelName: "\u041B\u0438\u0444\u0442\u044B \u0438 \u0432\u0435\u0441\u0430"
  levelName_en: Elevators and weights
  levelPrefab: {fileID: 0}
  description: "\u041E\u043F\u0443\u0441\u0442\u0438 4 \u043B\u0438\u0444\u0442\u0430,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435
    \u0442\u0438\u043F\u044B \u0434\u0430\u043D\u043D\u044B\u0445"
  description_en: Lower 4 elevators using the correct data types
  starterCode: "// \u041E\u043F\u0443\u0441\u0442\u0438 \u0432\u0441\u0435 4 \u043B\u0438\u0444\u0442\u0430!\r\n//
    \u041B\u0438\u0444\u0442 1: \u0432\u0435\u0441 126\r\n// \u041B\u0438\u0444\u0442
    2: \u0432\u0435\u0441 32766\r\n// \u041B\u0438\u0444\u0442 3: \u0432\u0435\u0441
    2147483646\r\n// \u041B\u0438\u0444\u0442 4: \u0432\u0435\u0441 9223372036854775806
    (\u043D\u0443\u0436\u0435\u043D \u0442\u0438\u043F long!)\r\n\r\n// \u041F\u0440\u0438\u043C\u0435\u0440:\r\n//
    byte w1 = 127;\r\n// Elevator.lower(1, w1);"
  starterCode_en: '// Lower all 4 elevators!

    // Elevator 1: weight 126

    //
    Elevator 2: weight 32766

    // Elevator 3: weight 2147483646

    // Elevator
    4: weight 9223372036854775806 (requires a long type!)


    // Example:

    //
    byte w1 = 127;

    // Elevator.lower(1, w1);'
  solutionCode: 'byte w1 = 127;

    Elevator.lower(1, w1);



    short w2 = 32767;

    Elevator.lower(2,
    w2);



    int w3 = 2147483647;

    Elevator.lower(3, w3);



    long w4 =
    9223372036854775807L;

    Elevator.lower(4, w4);

'
  playerStartPosition: {x: -11.35, y: -1.27, z: 0}
  goalPosition: {x: 20.709, y: 15.774, z: 0}
  attemptsBeforeFirstHint: 2
  hint1: "\U0001F4A1 \u041A\u0430\u0436\u0434\u044B\u0439 \u043B\u0438\u0444\u0442
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0439
    \u0432\u0435\u0441. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 byte \u0434\u043B\u044F
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0445 \u0447\u0438\u0441\u0435\u043B"
  hint2: "\U0001F4A1 byte: \u0434\u043E 127, short: \u0434\u043E 32767, int: \u0434\u043E
    2 147 483 647, long: \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435"
  hint3: "\U0001F4A1 Elevator.lower(id, \u0432\u0435\u0441) \u2014 long \u043B\u0438\u0442\u0435\u0440\u0430\u043B\u044B
    \u043F\u0438\u0448\u0443\u0442\u0441\u044F \u0441 L: 9223372036854775806L"
  hint1_en: "\U0001F4A1 Each elevator requires a certain weight. Try byte for small
    numbers."
  hint2_en: "\U0001F4A1 byte: up to 127, short: up to 32767, int: up to 2,147,483,647,
    long: even more"
  hint3_en: "\U0001F4A1 Elevator.lower(id, weight) \u2014 long literals are written
    with L: 9223372036854775806L"
  validations: []
  hint: "\U0001F4A1 \u041F\u0440\u0438\u043C\u0435\u0440:\nint distance = 5;\nPlayer.moveRight(distance);"
