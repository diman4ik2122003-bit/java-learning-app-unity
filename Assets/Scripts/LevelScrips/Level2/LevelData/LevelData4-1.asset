  m_Name: LevelData4-1
  m_EditorClassIdentifier: Assembly-CSharp::LevelData
  levelId: 4-1
  groupName: "\u0426\u0438\u043A\u043B\u044B"
  groupName_en: Loops
  levelName: "\u0421\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u043C\u043E\u0441\u0442\u0430"
  levelName_en: Building a bridge
  levelPrefab: {fileID: 0}
  description: "\u041D\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0447\u0435\u0440\u0435\u0437
    \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C, \u043D\u043E \u043C\u043E\u0441\u0442
    \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
    \u0446\u0438\u043A\u043B 'for', \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
    10 \u0434\u043E\u0449\u0435\u0447\u0435\u043A \u043F\u043E\u0434\u0440\u044F\u0434!
    \u0424\u0443\u043D\u043A\u0446\u0438\u044F Bridge.addPlank(i) \u043A\u043B\u0430\u0434\u0435\u0442
    \u0434\u043E\u0449\u0435\u0447\u043A\u0443 \u0432 \u0441\u043B\u043E\u0442 \u043F\u043E\u0434
    \u043D\u043E\u043C\u0435\u0440\u043E\u043C 'i'.\r\n"
  description_en: 'We need to cross the gap, but the bridge is broken. Use a ''for''
    loop to place 10 planks! The Bridge.addPlank(i) function places a plank in the
    slot numbered ''i''.

'
  starterCode: "// \u041C\u043E\u0441\u0442 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 10 \u0441\u043B\u043E\u0442\u043E\u0432 (\u043E\u0442 0 \u0434\u043E
    9)\r\n// \u041D\u0430\u043F\u0438\u0448\u0438 \u0446\u0438\u043A\u043B for, \u0447\u0442\u043E\u0431\u044B
    \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0438\u0445 \u0432\u0441\u0435!\r\n\r\nfor
    (int i = 0; i < 10; i++) {\r\n    // \u0442\u0432\u043E\u0439 \u043A\u043E\u0434
    \u0437\u0434\u0435\u0441\u044C\r\n    \r\n}\r\n"
  starterCode_en: "// The bridge consists of 10 slots (from 0 to 9)\r\n// Write a
    for loop to fill them all!\r\n\r\nfor (int i = 0; i < 10; i++) {\r\n    // your
    code here\r\n    \r\n}\r\n"
  solutionCode: "for (int i = 0; i < 10; i++) {\r\n    Bridge.addPlank(i);\r\n}\r\n"
  playerStartPosition: {x: -15.35, y: -1.27, z: 0}
  goalPosition: {x: 8.5, y: -1.38, z: 0}
  attemptsBeforeFirstHint: 2
  hint1: "\U0001F4A1 \u0426\u0438\u043A\u043B for \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
    \u0442\u0430\u043A: for (\u043D\u0430\u0447\u0430\u043B\u043E; \u0443\u0441\u043B\u043E\u0432\u0438\u0435;
    \u0448\u0430\u0433). \u041D\u0430\u0447\u043D\u0438 \u0441 int i = 0.\r\n"
  hint2: "\U0001F4A1 \u0412\u043D\u0443\u0442\u0440\u0438 \u0446\u0438\u043A\u043B\u0430
    \u0432\u044B\u0437\u043E\u0432\u0438 Bridge.addPlank(i); \u0447\u0442\u043E\u0431\u044B
    \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0434\u043E\u0449\u0435\u0447\u043A\u0443.\r\n"
  hint3: "\U0001F4A1 \u041F\u043E\u043B\u043D\u044B\u0439 \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043E\u043A
    \u0446\u0438\u043A\u043B\u0430: for (int i = 0; i < 10; i++) { ... }\r\n"
  hint1_en: "\U0001F4A1 A for loop looks like: for (start; condition; step). Start
    with int i = 0.\r\n"
  hint2_en: "\U0001F4A1 Inside the loop, call Bridge.addPlank(i); to add a plank.\r\n"
  hint3_en: "\U0001F4A1 The full loop header is: for (int i = 0; i < 10; i++) { ...
    }\r\n"
  validations: []
  hint: "\U0001F4A1 \u041F\u0440\u0438\u043C\u0435\u0440:\nint distance = 5;\nPlayer.moveRight(distance);"
