  levelName: "\u0410\u043B\u0445\u0438\u043C\u0438\u044F: float \u0438 double"
  levelName_en: 'Alchemy: float and double'
  levelPrefab: {fileID: 0}
  description: "\u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u0430\u0433\u0443 \u0441\u0432\u0430\u0440\u0438\u0442\u044C
    \u0437\u0435\u043B\u044C\u0435. \u041D\u0430\u043F\u0438\u0448\u0438 \u0446\u0438\u043A\u043B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 10 \u0440\u0430\u0437 \u0434\u043E\u0431\u0430\u0432\u0438\u0442
    \u043A\u0430\u043F\u043B\u044E \u0432 \u043A\u043E\u0442\u0435\u043B! \u0414\u043B\u044F
    \u043F\u0440\u043E\u0431\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
    \u0442\u0438\u043F float."
  description_en: Help the mage brew a potion. Write a loop that adds a drop 10 times.
    Use float for the first trial.
  starterCode: "float drop = 0.1f;\nfor (int i = 0; i < 10; i++) {\n    Alchemist.addDrop(1);\n}\n"
  starterCode_en: 
  solutionCode: "double drop = 0.1;\nfor (int i = 0; i < 10; i++) {\n    Alchemist.addDrop(1);\n}\n"
  playerStartPosition: {x: -9.958, y: -5.067, z: 0}
  goalPosition: {x: 5, y: 0, z: 0}
  attemptsBeforeFirstHint: 3
  hint1: "\U0001F4A1 \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E
    \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F"
  hint2: "\U0001F4A1 \u0421\u043E\u0437\u0434\u0430\u0439 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E:
    int distance = 5;"
  hint3: "\U0001F4A1 \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 Player.moveRight(distance);"
  hint1_en: 
  hint2_en: 
  hint3_en: 
  validations: []
  timeFor3Stars: 300
  attemptsFor3Stars: 2
  attemptsFor2Stars: 5
  steps:
  - stepName: Phase 1 (float)
    hints:
    - "\U0001F4A1 \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0446\u0438\u043A\u043B
      for (int i = 0; i < 10; i++), \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
      \u043A\u0430\u043F\u043B\u0438 10 \u0440\u0430\u0437."
    - "\U0001F4A1 \u0414\u043B\u044F \u043F\u0435\u0440\u0432\u043E\u0439 \u0444\u0430\u0437\u044B
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0442\u0438\u043F float.
      \u041E\u0431\u0440\u0430\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u043D\u0430 \u043F\u043E\u0433\u0440\u0435\u0448\u043D\u043E\u0441\u0442\u044C
      \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435!"
  - stepName: Phase 2 (double)
    hints:
    - "\U0001F4A1 \u041A\u043E\u0442\u0451\u043B \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F?
      \u042D\u0442\u043E \u0438\u0437-\u0437\u0430 \u043D\u0435\u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438
      float. \u0417\u0430\u043C\u0435\u043D\u0438 \u0435\u0433\u043E \u043D\u0430
      double."
    - "\U0001F4A1 double \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u0432
      \u0434\u0432\u0430 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043F\u0430\u043C\u044F\u0442\u0438, \u043D\u043E \u0434\u0430\u0435\u0442
      \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u0443\u044E \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u0434\u043B\u044F \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
      \u0437\u0435\u043B\u0438\u0439."
  hint: "\U0001F4A1 \u041F\u0440\u0438\u043C\u0435\u0440:\nint distance = 5;\nPlayer.moveRight(distance);"
