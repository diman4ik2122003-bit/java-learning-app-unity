    - target: {fileID: 225756100811605123, guid: 20bbdbac714c6844c9d510fa19be068d, type: 3}
      propertyPath: steps.Array.data[0].text_ru
      value: "\u0425\u043C\u043C... \u0412\u0440\u043E\u0434\u0435 10 \u043A\u0430\u043F\u0435\u043B\u044C,
        \n\u043D\u043E \u0437\u0435\u043B\u044C\u0435 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
        \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435... \n\u0413\u043B\u044F\u043D\u044C
        \u043D\u0430 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044E:
        \n{1}!"
      objectReference: {fileID: 0}
    - target: {fileID: 225756100811605123, guid: 20bbdbac714c6844c9d510fa19be068d, type: 3}
      propertyPath: steps.Array.data[1].text_ru
      value: "\u042D\u0442\u0430 \u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u043D\u0430
        \u043A\u043E\u043D\u0446\u0435 \u2014 \n\u043E\u0448\u0438\u0431\u043A\u0430
        float! \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0435\u0440\u0435\u043F\u0438\u0448\u0438
        \n\u043A\u043E\u0434, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
        \u0442\u0438\u043F double, \n\u0447\u0442\u043E\u0431\u044B \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
        \u0431\u044B\u043B\u0430 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0439!"
      objectReference: {fileID: 0}
    - target: {fileID: 225756100811605123, guid: 20bbdbac714c6844c9d510fa19be068d, type: 3}
      propertyPath: steps.Array.data[0].stepName
      value: Phase2TransitionSeq1
      objectReference: {fileID: 0}
    - target: {fileID: 225756100811605123, guid: 20bbdbac714c6844c9d510fa19be068d, type: 3}
